# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Supabase (Banco de Dados PostgreSQL com RLS)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-public-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secret-aqui
SUPABASE_JWT_SECRET=super_secret_jwt_string_aqui

# APIs de IA (Audio & LLM)
GROQ_API_KEY=gsk_sua_chave_groq_aqui
OPENAI_API_KEY=sk-proj-sua_chave_openai_aqui

# WhatsApp Meta Cloud API Oficial
META_WHATSAPP_TOKEN=EAAG...
META_PHONE_NUMBER_ID=1234567890
META_BUSINESS_ACCOUNT_ID=9876543210
META_VERIFY_TOKEN=minha_senha_secreta_webhook_123

# Gateway de Pagamento (Pix Online)
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
